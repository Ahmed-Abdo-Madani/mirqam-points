{
  "name": "@mirqam-points/mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mirqam Points Business — native iOS/Android shell (Capacitor) around the merchant console",
  "scripts": {
    "build:web": "npm run build:mobile -w @mirqam-points/web",
    "sync": "npm run build:web && cap sync",
    "assets": "capacitor-assets generate --iconBackgroundColor '#172740' --iconBackgroundColorDark '#172740' --splashBackgroundColor '#172740' --splashBackgroundColorDark '#0e1726'",
    "android:apk": "npm run sync && cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-updater": "^8.54.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
