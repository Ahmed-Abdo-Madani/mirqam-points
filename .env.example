# Copy to .env for local overrides. Everything has a working default in development.

# Database: postgres://… (production), pglite://<dir> (persistent local), memory:// (ephemeral).
# Default in development: pglite://<repo>/.data/pg
# DATABASE_URL=

# Port of the API (the Vite dev server proxies /api to it).
# PORT=4100

# Public origin of the web app — the only origin allowed to make cookie-authenticated writes.
# PUBLIC_URL=http://localhost:5174

# Login/register attempts per IP per minute.
# AUTH_RATE_LIMIT=20

# Session lifetime in days.
# SESSION_TTL_DAYS=30

# Subscriptions (Moyasar). Create a dedicated API key for this project in the Moyasar dashboard.
# sk_test_… for sandbox, sk_live_… in production (production refuses test keys).
# MOYASAR_SECRET_KEY=
# Optional: the secret_token set on the Moyasar webhook (https://<host>/api/billing/moyasar/webhook).
# MOYASAR_WEBHOOK_SECRET=
# Subscription emails via Resend. Without a key emails are skipped (events still show in-app).
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=Mirqam <no-reply@mirqam.sa>
# Paywall: set to 1 to make workspaces without an active subscription or trial read-only.
# BILLING_ENFORCE=0
# BILLING_TRIAL_DAYS=14
