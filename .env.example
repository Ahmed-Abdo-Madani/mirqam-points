# Copy to .env for local overrides. Everything has a working default in development.

# Database: postgres://… (production), pglite://<dir> (persistent local), memory:// (ephemeral).
# Default in development: pglite://<repo>/.data/pg
# DATABASE_URL=

# Port of the API (the Vite dev server proxies /api to it).
# PORT=4100

# Public origin of the web app — the only origin allowed to make cookie-authenticated writes.
# PUBLIC_URL=http://localhost:5174

# Login/register attempts per IP per minute.
# AUTH_RATE_LIMIT=20

# Session lifetime in days.
# SESSION_TTL_DAYS=30
